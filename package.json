{
  "name": "human-proyect-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test scripts/check.test.mjs",
    "check": "node scripts/check.mjs --root dist --preview",
    "check:publish": "node scripts/check.mjs --root dist",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
