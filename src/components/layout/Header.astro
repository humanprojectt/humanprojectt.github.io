---
import Button from "../shared/Button.astro";
import { navigation } from "../../content/navigation";
import { contactHref, site } from "../../content/site";

interface Props {
  subpage?: boolean;
}

const { subpage = false } = Astro.props;
---

<header class="site-header">
  {/* Text wordmark until the original logo file arrives. Do not redraw the logo. */}
  <a class="brand" href={subpage ? "/" : "#contenido"}>{site.name}</a>
  {
    !subpage && (
      <nav class="site-nav" aria-label="Principal">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    )
  }
  <Button variant="quiet" href={contactHref(subpage ? "/" : "")}>{site.contact.label}</Button>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.5rem var(--gutter);
    border-bottom: 1px solid var(--graphite);
    background: var(--black);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--white);
    font-size: 0.95rem;
    font-stretch: 75%;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-nav {
    display: none;
    gap: 1.5rem;
    font-size: 0.92rem;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--steel);
    text-decoration: none;
    transition: color var(--fast) ease;
  }

  .site-nav a:hover {
    color: var(--white);
  }

  .site-nav a:active {
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .site-nav {
      display: flex;
    }
  }
</style>
