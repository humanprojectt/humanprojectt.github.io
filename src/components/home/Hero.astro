---
import Button from "../shared/Button.astro";
import { hero } from "../../content/home";
import { contactHref, site } from "../../content/site";
---

<section class="hero">
  <p class="eyebrow">{hero.eyebrow}</p>
  <h1>{hero.title} <span class="metal">{hero.titleHighlight}</span></h1>
  <div class="hero-foot">
    <p class="promise">{hero.promise}</p>
    <Button href={contactHref()}>{site.contact.label}</Button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: min(84svh, 60rem);
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(2.5rem, 7svh, 5rem) var(--gutter);
    overflow: hidden;
    background: radial-gradient(90rem 42rem at 85% -10%, var(--glow), transparent 62%), var(--black);
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    color: var(--steel);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    color: var(--white);
    /* Bounded by height too, so the button stays on screen on laptops. */
    font-size: clamp(3rem, min(6.2vw, 12.5svh), 9rem);
    font-stretch: 68%;
    font-weight: 800;
    letter-spacing: -0.012em;
    line-height: 1;
    text-wrap: balance;
    word-spacing: 0.07em;
  }

  /* Brushed-metal fill, a nod to the steel of the brand */
  .metal {
    display: block;
    /* Room for descenders: background-clip paints only inside the box. */
    margin-bottom: -0.16em;
    padding-bottom: 0.16em;
    background: var(--metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-foot {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: clamp(1.75rem, 5svh, 4rem);
  }

  .promise {
    font-size: clamp(1.15rem, 1rem + 0.9vw, 1.7rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  /* Entrance, disabled under reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .hero > * {
      animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero > :nth-child(2) {
      animation-delay: 70ms;
    }

    .hero > :nth-child(3) {
      animation-delay: 160ms;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
    }
  }

  /* Clipped gradient text disappears when the system forces its own colors. */
  @media (forced-colors: active) {
    .metal {
      background: none;
      color: CanvasText;
    }
  }

  @media (min-width: 48rem) {
    .hero-foot {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>
