---
import Button from "../shared/Button.astro";
import { finalCta } from "../../content/home";
import { contactHref, site } from "../../content/site";

const missingContact = site.contact.url === null;
---

<section class="section final" id="contacto" aria-labelledby="contacto-titulo">
  <h2 id="contacto-titulo">{finalCta.title}</h2>
  <Button
    class="final-action"
    variant="inverse"
    href={contactHref()}
    data-pending={missingContact ? "canal de contacto de Yera" : undefined}
  >
    {site.contact.label}
  </Button>
  {missingContact && <p class="pending-note">{finalCta.missingContactNote}</p>}
</section>

<style>
  /* A light band that closes the page */
  .final {
    padding-block: clamp(6rem, 16vw, 13rem);
    border-top: 0;
    background: var(--silver);
    color: var(--black);
  }

  h2 {
    color: var(--black);
  }

  .final :global(:focus-visible) {
    outline-color: var(--black);
  }

  .final :global(.final-action) {
    margin-top: 2.75rem;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.35rem);
  }

  .pending-note {
    max-width: 44ch;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
